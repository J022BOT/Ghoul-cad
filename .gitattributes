# 默认按文本处理，换行符交给下面的规则
* text=auto

# 无扩展名的文本文件也统一 LF，避免 Windows 上被 eol 转换
.gitignore     text eol=lf
.gitattributes text eol=lf
LICENSE        text eol=lf

# Windows 脚本必须是 CRLF，否则 if/goto 块会解析错乱（踩过坑）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 源码与文档统一 LF，避免跨平台 diff 噪声
*.py  text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.js  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# DXF 是 CRLF 文本格式，按原样保存
*.dxf text eol=crlf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
